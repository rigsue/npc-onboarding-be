import { pool } from "../config/db.js";

export async function createUser(user, connection = pool) {
    const sql = `
    INSERT INTO users (
    first_name,
    last_name,
    email,
    password_hash,
    is_active
    )
    VALUES ($1, $2, $3, $4, $5)
    RETURNING
    user_id,
    first_name,
    last_name,
    email,
    password_hash,
    is_active,
    created_at;
    `;
    const values = [
        user.firstName,
        user.lastName,
        user.email,
        user.passwordHash,
        user.isActive
    ];
    const { rows } = await connection.query(sql, values);

    return rows[0];
}